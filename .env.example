# COURT IQ – Umgebungsvariablen
# Kopieren nach .env.local und mit den Werten aus dem Supabase-Dashboard füllen:
# Project Settings → API (bzw. „API Keys“). Niemals echte Werte einchecken.

# Öffentliche Projekt-URL, z. B. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable Key (sb_publishable_…) oder – bei älteren Projekten – der anon key.
# Dieser Schlüssel ist für den Browser bestimmt; der Schutz erfolgt über Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Nur für Integrationstests (Datei: .env.test.local, NICHT für die App, NIE im Frontend):
# SUPABASE_TEST_URL=
# SUPABASE_TEST_PUBLISHABLE_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
